# 默认按文本处理，交给 git 判断是否二进制
* text=auto

# Unity 的场景/预制体/资源是 YAML 文本，Unity 自己写的是 LF 行尾。
# 强制 eol=lf，避免 Windows 上 checkout 成 CRLF 后每次 diff 整文件。
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.mat text eol=lf
*.controller text eol=lf
*.anim text eol=lf
*.scenetemplate text eol=lf

*.cs text eol=lf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.txt text eol=lf

# 图片确实不该做行尾转换（Unity 的 .png.meta 会写 textureFormat 等信息，改动很常见）
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary

# 二进制工程文件
*.dll binary
*.so binary
*.dylib binary
*.pdb binary
*.exe binary
